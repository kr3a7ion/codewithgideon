{
  "name": "code-with-gideon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender-meta.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cwg-rules \"node --test tests/*.test.mjs\"",
    "preview:ui": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "firebase-functions": "^7.0.6",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-paystack": "^6.0.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.19.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
