rules_version = '2';

// Firebase Storage rules. Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Screenshots students attach to mentor chat: each student writes only
    // into their own folder, images up to 5 MB. Gideon can read them all.
    match /mentor-uploads/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
      allow delete: if isAdmin();
    }

    // Files Gideon uploads for resources: anyone signed in can read them.
    match /resources/{file=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
    }

    // Pictures and videos for the public site (Admin → Site media).
    // Anyone can view them; only admins upload or delete. Images are shrunk
    // in the browser first; videos are capped at 50 MB.
    match /site-media/{file} {
      allow read: if true;
      allow create: if isAdmin()
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 25 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size < 50 * 1024 * 1024)
        );
      allow delete: if isAdmin();
    }

    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
